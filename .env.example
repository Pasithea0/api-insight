APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=changeme

# PostgreSQL connection URL (required).
# Example: postgres://user:pass@host:port/dbname?sslmode=disable
APP_DATABASE_URL=postgres://user:pass@localhost:5432/postgres?sslmode=disable

# Number of days to retain raw events and aggregates.
APP_RETENTION_DAYS=30

# Address the HTTP server listens on.
APP_LISTEN_ADDR=:8080

# Internal API key for self-reporting metrics from this API Insight instance.
# If set, this API will report its own request metrics to itself.
# If empty, internal reporting is disabled.
APP_INTERNAL_API_KEY=

# Statement timeout in milliseconds (default: 30000 = 30s).
# Set to 0 to disable the timeout.
APP_STATEMENT_TIMEOUT_MS=120000

# Session secret for signing cookies. Auto-generated if empty.
# In production, set this to a long random string.
APP_SESSION_SECRET=

# Log level: debug, info, warn, error, fatal (default: info).
APP_LOG_LEVEL=info

# Set to "true" for human-readable console output instead of JSON lines.
APP_PRETTY_LOG=true

# ---------------------------------------------------------------------------
# TimescaleDB (optional, on by default)
# ---------------------------------------------------------------------------
#
# Turns the `events` table into a TimescaleDB hypertable: time-partitioned
# chunks, columnstore compression, chunk-drop retention and in-database
# hourly rollups. Every step is a no-op when the connected Postgres does not
# have the timescaledb extension, so this is safe to leave on with plain
# Postgres. Requires a Postgres image with TimescaleDB, e.g.
# timescale/timescaledb:latest-pg17 (see docs/timescaledb-clickhouse.md).

# Set to false to disable TimescaleDB handling entirely.
APP_TIMESCALE_ENABLED=true

# Time span covered by each chunk. Bare integers are read as days, so
# "1" and "24h" are equivalent.
APP_TIMESCALE_CHUNK_INTERVAL=24h

# Age at which a chunk is moved to columnstore (compressed) storage.
# 0 disables columnstore. Must exceed the longest per-key retention window:
# rows in a compressed chunk can still be deleted, but it is far cheaper to
# let a whole chunk age out than to delete rows from one.
APP_TIMESCALE_COLUMNSTORE_AFTER=14

# Hard age ceiling on raw events, enforced by dropping whole chunks. This is
# a floor on top of per-API-key retention, never a replacement: a key may ask
# for fewer days, never more. 0 disables it.
APP_RAW_RETENTION_DAYS=30

# Materialise hourly rollups inside the database so the rollup worker reads
# pre-computed rows instead of scanning raw events. Requires the extension.
APP_TIMESCALE_CONTINUOUS_AGGREGATES=true

# ---------------------------------------------------------------------------
# ClickHouse (optional, off by default)
# ---------------------------------------------------------------------------
#
# Mirrors every ingested event into ClickHouse alongside Postgres. Postgres
# stays the system of record for ownership, API keys and the dashboard
# rollups; ClickHouse is a wide, compressed, columnar copy for long-range
# queries and search. Requires BOTH a DSN and the enabled flag.

APP_CLICKHOUSE_ENABLED=false
# Example: clickhouse://user:password@host:9000/apiinsight
# Credentials are redacted before this DSN is ever logged.
APP_CLICKHOUSE_DSN=
# Extra global age TTL for the ClickHouse table, on top of each row's own
# expires_at. 0 means rely on per-row expiry only.
APP_CLICKHOUSE_RETENTION_DAYS=0

