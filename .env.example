APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=changeme

# PostgreSQL connection URL (required).
# Example: postgres://user:pass@host:port/dbname?sslmode=disable
APP_DATABASE_URL=postgres://user:pass@localhost:5432/postgres?sslmode=disable

# Number of days to retain raw events and aggregates.
APP_RETENTION_DAYS=30

# Address the HTTP server listens on.
APP_LISTEN_ADDR=:8080

# Internal API key for self-reporting metrics from this API Insight instance.
# If set, this API will report its own request metrics to itself.
# If empty, internal reporting is disabled.
APP_INTERNAL_API_KEY=

# Statement timeout in milliseconds (default: 30000 = 30s).
# Set to 0 to disable the timeout.
APP_STATEMENT_TIMEOUT_MS=30000

# Session secret for signing cookies. Auto-generated if empty.
# In production, set this to a long random string.
APP_SESSION_SECRET=

# Log level: debug, info, warn, error, fatal (default: info).
APP_LOG_LEVEL=info

# Set to "true" for human-readable console output instead of JSON lines.
APP_PRETTY_LOG=true
