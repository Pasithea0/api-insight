APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=changeme

# PostgreSQL connection URL (required).
# Example: postgres://user:pass@host:port/dbname?sslmode=disable
APP_DATABASE_URL=postgres://user:pass@localhost:5432/postgres?sslmode=disable

# Number of days to retain raw events and aggregates.
#
# 0 means UNLIMITED: raw events are kept forever, nothing expires them, and
# the retention pass does nothing. That is only sensible when the events live
# in an object store (APP_EVENT_STORE=s3), where storage is cheap and
# effectively unbounded. With the events in Postgres it means the `events`
# table grows without bound on the database host, which is how the disk filled
# up in the first place — the service warns at startup when it sees that
# combination.
#
# Individual API keys can still ask for a shorter window of their own; the
# value here is the ceiling they are clamped to, and it is also the default
# they inherit when they ask for nothing.
APP_RETENTION_DAYS=30

# Address the HTTP server listens on.
APP_LISTEN_ADDR=:8080

# Internal API key for self-reporting metrics from this API Insight instance.
# If set, this API will report its own request metrics to itself.
# If empty, internal reporting is disabled.
APP_INTERNAL_API_KEY=

# Statement timeout in milliseconds (default: 30000 = 30s).
# Set to 0 to disable the timeout.
APP_STATEMENT_TIMEOUT_MS=120000

# Session secret for signing cookies. Auto-generated if empty.
# In production, set this to a long random string.
APP_SESSION_SECRET=

# Log level: debug, info, warn, error, fatal (default: info).
APP_LOG_LEVEL=info

# Set to "true" for human-readable console output instead of JSON lines.
APP_PRETTY_LOG=true

# ---------------------------------------------------------------------------
# TimescaleDB (optional, on by default)
# ---------------------------------------------------------------------------
#
# Turns the `events` table into a TimescaleDB hypertable: time-partitioned
# chunks, columnstore compression, chunk-drop retention and in-database
# hourly rollups. Every step is a no-op when the connected Postgres does not
# have the timescaledb extension, so this is safe to leave on with plain
# Postgres. Requires a Postgres image with TimescaleDB, e.g.
# timescale/timescaledb:latest-pg17 (see docs/timescaledb-clickhouse.md).

# Set to false to disable TimescaleDB handling entirely.
APP_TIMESCALE_ENABLED=true

# Time span covered by each chunk. Bare integers are read as days, so
# "1" and "24h" are equivalent.
APP_TIMESCALE_CHUNK_INTERVAL=24h

# Age at which a chunk is moved to columnstore (compressed) storage.
# 0 disables columnstore. Must exceed the longest per-key retention window:
# rows in a compressed chunk can still be deleted, but it is far cheaper to
# let a whole chunk age out than to delete rows from one.
APP_TIMESCALE_COLUMNSTORE_AFTER=14

# Hard age ceiling on raw events, enforced by dropping whole chunks. This is
# a floor on top of per-API-key retention, never a replacement: a key may ask
# for fewer days, never more. 0 disables it.
APP_RAW_RETENTION_DAYS=30

# Materialise hourly rollups inside the database so the rollup worker reads
# pre-computed rows instead of scanning raw events. Requires the extension.
APP_TIMESCALE_CONTINUOUS_AGGREGATES=true

# ---------------------------------------------------------------------------
# ClickHouse (optional, off by default)
# ---------------------------------------------------------------------------
#
# Mirrors every ingested event into ClickHouse alongside Postgres. Postgres
# stays the system of record for ownership, API keys and the dashboard
# rollups; ClickHouse is a wide, compressed, columnar copy for long-range
# queries and search. Requires BOTH a DSN and the enabled flag.

APP_CLICKHOUSE_ENABLED=false
# Example: clickhouse://user:password@host:9000/apiinsight
# Credentials are redacted before this DSN is ever logged.
APP_CLICKHOUSE_DSN=
# Extra global age TTL for the ClickHouse table, on top of each row's own
# expires_at. 0 means rely on per-row expiry only.
APP_CLICKHOUSE_RETENTION_DAYS=0

# Which store serves the raw-event dashboard endpoints (recent, all-events,
# search-events, export, event detail): "postgres" (default) or "clickhouse".
# Writing the mirror and reading from it are separate decisions on purpose:
# the mirror has no backfill, so for the first days after it is enabled it
# holds LESS history than Postgres, and switching reads over immediately
# would lose search results. Once it has caught up, flip this.
# Any request can override it with ?store=clickhouse|postgres.
APP_CLICKHOUSE_READ_SOURCE=postgres

# ---------------------------------------------------------------------------
# Event storage backend (optional; Postgres by default)
# ---------------------------------------------------------------------------
#
# Where RAW events live. "postgres" (default) writes them into the `events`
# table. "s3" writes them to an S3-compatible object store — Backblaze B2,
# MinIO, AWS S3 — and never writes the `events` table at all.
#
# Postgres is still required either way, and is still the system of record:
# users, API keys, sessions and the pre-aggregated rollup tables
# (metric_buckets, route_buckets, daily_*) live there. Those are small. Only
# the raw stream — the part that grows by millions of rows a day and was
# filling the host's disk — moves.
#
# In "s3" mode the rollup worker rebuilds the hourly buckets by streaming
# each hour back out of the bucket and aggregating in Go, so every chart,
# top-routes list and CSV export keeps working unchanged. See
# docs/object-store.md for the migration runbook and the trade-offs.
#
# NOTE: with "s3" configured, an unreachable bucket is a fatal startup error.
# The service refuses to start rather than quietly writing raw events into the
# database instead, because that is exactly how the disk filled up.
APP_EVENT_STORE=postgres

# S3-compatible endpoint. For Backblaze B2 the host is
# s3.<region>.backblazeb2.com. Scheme defaults to https.
APP_S3_ENDPOINT=

# Signing region. B2 reports it as part of the endpoint host.
APP_S3_REGION=us-east-1

# Bucket that holds the event objects.
APP_S3_BUCKET=

# Credentials. On B2 these are the application key ID and the application key.
# These are secrets: set them in the deployment's environment, never in a
# committed file.
APP_S3_ACCESS_KEY_ID=
APP_S3_SECRET_ACCESS_KEY=

# Key prefix every object is written under.
APP_S3_PREFIX=events

# Put the bucket in the path rather than the host. B2 and MinIO want this.
# Set to false for AWS S3.
APP_S3_PATH_STYLE=true

# How long ingested events are buffered before becoming one object per hour
# bucket. Longer means fewer, larger objects and cheaper listing; shorter
# means fresher data in the "recent events" panel. Bare integers are read as
# days, so use a Go duration ("30s", "2m").
APP_S3_FLUSH_INTERVAL=30s

# In-memory buffer ceiling. Reaching it forces an immediate flush, so a burst
# cannot grow memory without bound.
APP_S3_MAX_BUFFER_EVENTS=200000

# How many completed hours the rollup worker re-reads from the bucket at
# startup. The object store has no SQL, so a restart cannot recompute a
# missing hour any other way. Each hour is a download; lower it if the boot
# is too slow, but then an hour missed while the service was down stays
# unaggregated.
APP_S3_STARTUP_SCAN_HOURS=24

# Bound on a single object read.
APP_S3_READ_TIMEOUT=30s


